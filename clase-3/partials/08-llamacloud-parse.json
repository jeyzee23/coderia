        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input_url: $json.fileUrl, output_schema: $json.outputSchema || { \"text\": \"string\", \"metadata\": \"object\" }, tier: \"premium\" }) }}",
        "options": {
