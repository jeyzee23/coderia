        }
      },
      "id": "http-upload-c4",
      "name": "📤 Upload a LlamaCloud",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        280
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Extraer job_id del response de upload\nconst data = $input.first().json;\nconst jobId = data?.job?.id || data?.id;\n\nif (!jobId) {\n  return [{\n    json: {\n      error: \"No se pudo obtener job_id de LlamaCloud\",\n      validJob: false\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    jobId: jobId,\n    validJob: true\n  }\n}];",
        "options": {}
      },
      "id": "code-extract-jobid",
      "name": "🎯 Extraer Job ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        280
      ]
    },
    {
      "parameters": {
        "maxTries": 8,
        "waitBetweenTries": 4000,
        "options": {}
      },
      "id": "wait-c4",
      "name": "⏳ Esperar procesamiento",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        280
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.cloud.llamaindex.ai/api/parsing/job/{{ $json.jobId }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LLAMA_CLOUD_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-result-c4",
      "name": "📥 Obtener resultado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parser de respuesta LlamaCloud\n// Devuelve estructuras separadas: texto, markdown, tablas, metadata\n\nconst data = $input.first().json;\nconst txt = data?.text || data?.txt || '';\nconst md = data?.markdown || data?.md || '';\nconst json = data?.json || [];\n\n// Extraer tablas del markdown (formato | col1 | col2 |)\nfunction extractTables(markdown) {\n  const tableRegex = /\\|[^\\n]+\\|/g;\n  const matches = markdown.match(tableRegex) || [];\n  const tables = [];\n  let currentTable = [];\n  \n  for (const line of matches) {\n    const cells = line.split('|').filter(c => c.trim());\n    if (cells.some(c => c.includes('---'))) {\n      if (currentTable.length > 0) {\n        tables.push(currentTable);\n        currentTable = [];\n      }\n    } else {\n      currentTable.push(cells.map(c => c.trim()));\n    }\n  }\n  if (currentTable.length > 0) {\n    tables.push(currentTable);\n  }\n  return tables;\n}\n\nconst tables = extractTables(md);\n\nreturn [{\n  json: {\n    originalText: txt,\n    markdown: md,\n    tables: tables,\n    tableCount: tables.length,\n    pageCount: json.length || 1,\n    metadata: {\n      parsedAt: new Date().toISOString(),\n      jobId: data.jobId || null,\n      sourceFormat: data.fileUrl?.split('.').pop() || 'unknown'\n    }\n  }\n}];",
        "options": {}
      },
      "id": "code-parse-result",
      "name": "📊 Parsear resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "// Anonimización de datos sensibles en texto\n// Usa REGEX para detectar y enmascarar patrones sensibles\n\nconst data = $input.first().json;\nlet originalText = data.originalText || '';\nlet markdown = data.markdown || '';\n\n// Patrones de PII a anonimizar\nconst patterns = [\n  // DNI argentino (formato 00.000.000 o 00000000)\n  { pattern: /\\b\\d{1,2}\\.\\d{3}\\.\\d{3}\\b/g, replacement: '[DNI]' },\n  { pattern: /\\b\\d{7,8}\\b/g, replacement: '[DNI]' },\n  // CUIT/CUIL\n  { pattern: /\\b\\d{2}-\\d{7,8}-\\d\\b/g, replacement: '[CUIT]' },\n  // Fechas de nacimiento (detectadas en contexto de \"nac\", \"fecha nac\", \"nacimiento\")\n  { pattern: /\\b(\\d{1,2}[\\/\\-]\\d{1,2}[\\/\\-]\\d{2,4})\\b/gi, replacement: '[FECHA]' },\n  // Teléfonos\n  { pattern: /\\b\\d{3,4}[\\s\\-]?\\d{3,4}[\\s\\-]?\\d{3,4}\\b/g, replacement: '[TELEFONO]' },\n  { pattern: /\\b\\+54\\d{9,}/g, replacement: '[TELEFONO]' },\n  // Emails\n  { pattern: /\\b[\\w.-]+@[\\w.-]+\\.\\w+\\b/gi, replacement: '[EMAIL]' },\n  // Nombres propios (heurística: palabras que siguen a \"Sr.\", \"Sra.\", \"Paciente\", \"Nombre\")\n  { pattern: /\\b(Sr\\.?|Sra\\.?|Dr\\.?|Dra\\.?)\\s+[A-Z][a-z]+ [A-Z][a-z]+\\b/g, replacement: '[NOMBRE]' },\n  // Nombres en contexto de paciente\n  { pattern: /\\bPaciente[:\\s]+[A-Z][a-z]+ [A-Z][a-z]+\\b/gi, replacement: 'Paciente: [NOMBRE]' }\n];\n\n// Aplicar anonymization al texto\nfor (const { pattern, replacement } of patterns) {\n  originalText = originalText.replace(pattern, replacement);\n  markdown = markdown.replace(pattern, replacement);\n}\n\nreturn [{\n  json: {\n    ...data,\n    anonymizedText: originalText,\n    anonymizedMarkdown: markdown,\n    anonymization: {\n      applied: true,\n      patternsUsed: patterns.length,\n      maskedAt: new Date().toISOString()\n    }\n  }\n}];",
        "options": {}
      },
      "id": "code-anonymize",
      "name": "🔒 Anonimizar PII",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
